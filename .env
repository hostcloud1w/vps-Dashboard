MONGO_URI=mongodb://localhost:27017/vpsdashboard
JWT_SECRET=change-this-to-something-random
PORT=3000

# Public IPv4 of this host (used for direct URLs)
HOST_IP=203.0.113.42

# Cloudflare Tunnel (leave blank to skip tunnel mode)
TUNNEL_ID=
BASE_DOMAIN=vps.yourdomain.com
PANEL_HOSTNAME=panel.yourdomain.com
CLOUDFLARED_CONFIG=/root/.cloudflared/config.yml

# Cloudflare API (for auto subdomain DNS)
CF_API_TOKEN=
CF_ZONE_ID=

# Port allocation
PORT_RANGE_START=2004
PORT_RANGE_END=2200
